*.o
*.obj
*.so
*.dylib
*.dll
*.a
*.lib

# Profiling e Cobertura de Código (gprof, gcov)
gmon.out
*.gcno
*.gcda
*.gcov

# Depuração e Símbolos
*.dSYM/
*.su
*.idb
*.pdb

# Diretórios de Build
build/
bin/
dist/

# IDEs e Editores de Código
.vscode/
.idea/
*.swp
